<Project>
  <!--
    Developer builds only: override the VSTO manifest certificate thumbprint so the
    local developer certificate is used. This target must NOT run in CI because CI
    passes ManifestCertificateThumbprint on the MSBuild command line with a freshly
    created ephemeral certificate; a target-scoped PropertyGroup would override that
    command-line value and break the build.
  -->
  <Target Name="SetTaskMasterManifestCert" BeforeTargets="ResolveKeySource"
          Condition="'$(MSBuildProjectName)' == 'TaskMaster' and '$(CI)' != 'true'">
    <PropertyGroup>
      <SignManifests>true</SignManifests>
      <ManifestKeyFile></ManifestKeyFile>
      <ManifestCertificateThumbprint>88E95FCC6F066C07776218A398BF7046A447D802</ManifestCertificateThumbprint>
    </PropertyGroup>
  </Target>
</Project>
