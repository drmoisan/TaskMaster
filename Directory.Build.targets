<Project>
  <!--
    CI builds: disable VSTO manifest and assembly signing so that
    ResolveKeySource (Microsoft.Common.targets) does not attempt to
    locate a certificate that only exists on the developer machine.
    These top-level PropertyGroups are evaluated after the .csproj
    static PropertyGroups, effectively overriding SignManifests and
    SignAssembly for CI.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true' and '$(MSBuildProjectName)' == 'TaskMaster'">
    <SignManifests>false</SignManifests>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <!--
    Solution-wide strict nullable verification currently applies newer compiler
    settings to legacy C# projects that are not fully migrated. Keep that
    command buildable by aligning the language version and suppressing the
    existing legacy warning buckets only for that forced verification path.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(Nullable)' == 'enable' and '$(TreatWarningsAsErrors)' == 'true'">
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);nullable;CS0067;CS0168;CS0169;CS0618;CS0649;CS8632;MSTEST0032</NoWarn>
  </PropertyGroup>

  <!--
    Developer builds only: override the VSTO manifest certificate
    thumbprint so the local developer certificate is used.
  -->
  <Target
    Name="SetTaskMasterManifestCert"
    BeforeTargets="ResolveKeySource"
    Condition="'$(MSBuildProjectName)' == 'TaskMaster' and '$(CI)' != 'true'"
  >
    <PropertyGroup>
      <SignManifests>true</SignManifests>
      <ManifestKeyFile></ManifestKeyFile>
      <ManifestCertificateThumbprint>88E95FCC6F066C07776218A398BF7046A447D802</ManifestCertificateThumbprint>
    </PropertyGroup>
  </Target>
</Project>
