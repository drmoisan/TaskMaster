{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: restore",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/vscode/Invoke-Restore.ps1",
        "-SolutionPath",
        "TaskMaster.sln",
        "-Configuration",
        "Debug",
        "-Platform",
        "Any CPU"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ],
      "detail": "Workspace override for legacy VSTO/WPF restore using Visual Studio MSBuild."
    },
    {
      "label": "dotnet: build",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/vscode/Invoke-VSBuild.ps1",
        "-SolutionPath",
        "TaskMaster.sln",
        "-Configuration",
        "Debug",
        "-Platform",
        "Any CPU"
      ],
      "dependsOn": [
        "dotnet: restore"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ],
      "detail": "Workspace override for legacy VSTO/WPF build using Visual Studio MSBuild."
    },
    {
      "label": "format: csharpier",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "tool",
        "run",
        "csharpier",
        "format",
        "."
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "restore: TaskMaster.sln",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/vscode/Invoke-Restore.ps1",
        "-SolutionPath",
        "TaskMaster.sln",
        "-Configuration",
        "Debug",
        "-Platform",
        "Any CPU"
      ],
      "group": "build"
    },
    {
      "label": "build: TaskMaster.sln (VS MSBuild)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/vscode/Invoke-VSBuild.ps1",
        "-SolutionPath",
        "TaskMaster.sln",
        "-Configuration",
        "Debug",
        "-Platform",
        "Any CPU"
      ],
      "dependsOn": [
        "dotnet: restore"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "lint: TaskMaster.sln (.NET analyzers)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/vscode/Invoke-VSBuild.ps1",
        "-SolutionPath",
        "TaskMaster.sln",
        "-Configuration",
        "Debug",
        "-Platform",
        "Any CPU",
        "-EnableNETAnalyzers",
        "-EnforceCodeStyleInBuild"
      ],
      "dependsOn": [
        "dotnet: restore"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "type-check: TaskMaster.sln (nullable warnings as errors)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/vscode/Invoke-VSBuild.ps1",
        "-SolutionPath",
        "TaskMaster.sln",
        "-Configuration",
        "Debug",
        "-Platform",
        "Any CPU",
        "-EnableNullable",
        "-TreatWarningsAsErrors"
      ],
      "dependsOn": [
        "dotnet: restore"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "test: MSTest (vstest.console)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/vscode/Invoke-MSTest.ps1",
        "-SearchRoot",
        ".",
        "-Configuration",
        "Debug",
      ],
      "dependsOn": [
        "build: TaskMaster.sln (VS MSBuild)"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test: MSTest with Coverage (Koverage)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/vscode/Invoke-MSTestWithCoverage.ps1",
        "-SearchRoot",
        ".",
        "-Configuration",
        "Debug"
      ],
      "dependsOn": [
        "build: TaskMaster.sln (VS MSBuild)"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "clean other worktrees",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$root = git rev-parse --show-toplevel; git worktree list --porcelain | Select-String '^worktree (.+)' | ForEach-Object { $_.Matches[0].Groups[1].Value } | Where-Object { $_ -ne $root } | ForEach-Object { git worktree remove --force $_ }"
      ],
      "problemMatcher": [],
      "detail": "Removes every git worktree except the one currently open. --force discards uncommitted changes in the removed worktrees."
    }
  ]
}
